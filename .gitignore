# dependencies
node_modules/

# foreign lockfiles (this project uses pnpm)
package-lock.json
yarn.lock

# build output
dist/

# testing
coverage/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo

# local settings
.claude/*.local.json

# storysync output written when developing against a local Storybook.
# Its contents rather than the directory, so a file in it can be let back in.
**/.storysync/*

# example project dependencies
examples/*/node_modules/

# the baseline CI runs the drift-check action against
!examples/storybook-vite/.storysync/baseline.json
